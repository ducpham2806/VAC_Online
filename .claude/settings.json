{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/read-guard.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/secret-guard.sh"
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "agent-sprite-forge": {
      "source": {
        "source": "github",
        "repo": "0x0funky/agent-sprite-forge"
      }
    }
  },
  "enabledPlugins": {
    "agent-sprite-forge@agent-sprite-forge": true
  }
}
